DATABASE_URL=postgresql+psycopg://logistica:change-me@db:5432/logistica_db
APP_VERSION=0.1.0
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
STRICT_EVIDENCE_VALIDATION=false
BOOTSTRAP_ADMIN_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#CORS_ALLOWED_ORIGINS=https://dafreqlogistica.com,https://www.dafreqlogistica.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
APP_PUBLIC_URL=https://dafreqlogistica.com

WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@dafreqlogistica.com

# Bitácora de auditoría (desactivada durante el despliegue gradual)
AUDIT_ENABLED=false
AUDIT_IP_HMAC_KEY=
AUDIT_IP_HASH_VERSION=1
AUDIT_TRUSTED_PROXIES=
AUDIT_USER_AGENT_MAX_LENGTH=300
AUDIT_RETENTION_MONTHS=24
AUDIT_MAX_JSON_BYTES=8192

# Respaldo y restauración
BACKUP_ENABLED=true
BACKUP_STORAGE_DIR=/var/lib/dafreq-backups
BACKUP_TEMP_DIR=/var/lib/dafreq-backups/work
BACKUP_MAX_UPLOAD_BYTES=2147483648
BACKUP_MAX_UNCOMPRESSED_BYTES=8589934592
BACKUP_MAX_COMPRESSION_RATIO=100
BACKUP_DAILY_ENABLED=true
BACKUP_DAILY_TIME=02:00
BACKUP_TIMEZONE=America/Mexico_City
BACKUP_RETENTION_AUTOMATIC_COUNT=30
BACKUP_RETENTION_PRE_RESTORE_COUNT=10
BACKUP_VALIDATION_TTL_MINUTES=60
BACKUP_CONFIRMATION_TTL_MINUTES=5
BACKUP_OPERATION_TIMEOUT_SECONDS=3600
BACKUP_DRAIN_TIMEOUT_SECONDS=30
BACKUP_WORKER_POLL_SECONDS=2
BACKUP_TEMP_RETENTION_HOURS=24
BACKUP_MAX_PACKAGE_ENTRIES=16
BACKUP_STREAM_CHUNK_BYTES=1048576
